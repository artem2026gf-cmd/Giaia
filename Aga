    for _, obj in ipairs({ entry.box, entry.bb, entry.head, entry.chams }) do
        if obj then pcall(function() obj:Destroy() end) end
    end
    if entry.snap then pcall(function() entry.snap:Destroy() end) end
    for _, line in ipairs(entry.bones) do pcall(function() line:Destroy() end) end
    for _, line in ipairs(entry.bonesVis) do pcall(function() line:Destroy() end) end
end
MV.DestroyEntry = destroyEntry

local function drawBox(e, cx, cy, width, height, color, fade)
    if not O.EspBox then e.box.Visible = false return end
    e.box.Visible = true
    e.box.Position = UDim2.fromOffset(cx, cy)
    e.box.Size = UDim2.fromOffset(width, height)
    local weight = math.max(math.floor(O.EspBoxThick), 1)
    local corner = O.EspBoxStyle == "corner"
    local arm = corner and math.max(width*math.clamp(O.EspBoxCorner,0.05,0.5),4) or 0
    for i, edge in ipairs(e.edges) do
        edge.BackgroundColor3 = color
        edge.BackgroundTransparency = fade or 0
        local horizontal = i <= 4
        local length = horizontal and ((arm>0) and arm or width)
            or ((arm>0) and arm or height)
        if horizontal then
            edge.Size = UDim2.fromOffset(length, weight)
            edge.Position = UDim2.fromOffset((i%2==1) and 0 or (width-length),
                (i<=2) and 0 or (height-weight))
        else
            edge.Size = UDim2.fromOffset(weight, length)
            edge.Position = UDim2.fromOffset((i%2==1) and 0 or (width-weight),
                (i<=6) and 0 or (height-length))
        end
    end
    e.fill.BackgroundColor3 = color
    e.fill.BackgroundTransparency = math.clamp(O.EspBoxFill, 0, 1)
    e.fill.Visible = O.EspBoxFill < 1
end

local function applyChams(e, enabled, color)
    local h = e.chams
    if not h then return end
    if not enabled then
        if h.Enabled then h.Enabled = false end
        return
    end
    if e.character and h.Adornee ~= e.character then h.Adornee = e.character end
    if h.FillColor ~= color then h.FillColor = color; h.OutlineColor = color end
    h.FillTransparency = math.clamp(O.EspChamsFill, 0, 1)
    h.OutlineTransparency = math.clamp(O.EspChamsOut, 0, 1)
    h.DepthMode = O.EspChamsDepth and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
    if not h.Enabled then h.Enabled = true end
end

local BONES = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function partVisible(part, character)
    local cam = workspace.CurrentCamera
    if not cam or not part then return false end
    rayParams.FilterDescendantsInstances = { LP.Character, character, cam }
    local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rayParams)
    return hit == nil or hit.Instance:IsDescendantOf(character)
end

local function drawSkeleton(e, enemy)
    if not O.EspSkel then
        for _, l in ipairs(e.bones) do l.Visible = false end
        for _, l in ipairs(e.bonesVis) do l.Visible = false end
        return
    end
    local character = e.character
    local mainColor = enemy and MV.col(O.EspEnemyCol) or MV.col(O.EspAllyCol)
    local used, usedVis = 0, 0
    for _, pair in ipairs(BONES) do
        local a = character:FindFirstChild(pair[1])
        local b = character:FindFirstChild(pair[2])
        if a and b then
            local pa, va, za = project(a.Position)
            local pb, vb, zb = project(b.Position)
            if pa and pb and va and vb and za>0 and zb>0 then
                used = used + 1
                local line = e.bones[used]
                if not line then
                    line = MV.Mk("Frame", layer, {
                        BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5), ZIndex = 4,
                    })
                    e.bones[used] = line
                end
                local d = pb - pa
                line.Size = UDim2.fromOffset(math.max(d.Magnitude,1), O.EspSkelThick)
                line.Position = UDim2.fromOffset((pa.X+pb.X)*0.5, (pa.Y+pb.Y)*0.5)
                line.Rotation = math.deg(math.atan2(d.Y, d.X))
                line.BackgroundColor3 = mainColor
                line.Visible = true
                if O.EspSkelVis then
                    if partVisible(a, character) or partVisible(b, character) then
                        usedVis = usedVis + 1
                        local vline = e.bonesVis[usedVis]
                        if not vline then
                            vline = MV.Mk("Frame", layer, {
                                BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5), ZIndex = 5,
                            })
                            e.bonesVis[usedVis] = vline
                        end
                        vline.Size = UDim2.fromOffset(math.max(d.Magnitude,1), O.EspSkelThick+0.5)
                        vline.Position = line.Position
                        vline.Rotation = line.Rotation
                        vline.BackgroundColor3 = MV.col("lime")
                        vline.BackgroundTransparency = 0.2
                        vline.Visible = true
                    end
                end
            end
        end
    end
    for i = used+1, #e.bones do e.bones[i].Visible = false end
    for i = usedVis+1, #e.bonesVis do e.bonesVis[i].Visible = false end
end

local function pickColor(player, enemy, invul)
    if O.EspRgbForce and O.EspRgb then
        return Color3.fromHSV((tick()*0.3)%1, 0.9, 1)
    end
    if invul then return MV.col(O.EspInvulCol) end
    if O.EspTarget and State.EspFocus == player then
        return MV.col(O.EspTargetCol)
    end
    return enemy and MV.col(O.EspEnemyCol) or MV.col(O.EspAllyCol)
end

local function drawOne(e, enemy)
    local character = e.character
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health<=0 then return end
    local invul = MV.IsInvul(character, e.player)
    local bounds = espBounds(character, root)
    if not bounds then
        e.box.Visible=false; e.bb.Visible=false; e.head.Visible=false
        if e.snap then e.snap.Visible=false end
        for _, l in ipairs(e.bones) do l.Visible=false end
        for _, l in ipairs(e.bonesVis) do l.Visible=false end
        applyChams(e, false)
        return
    end
    local left, topY, right, bottomY2, onScreen, width, height, cx, cy = espBounds(character, root)
    if not onScreen then
        e.box.Visible=false; e.bb.Visible=false; e.head.Visible=false
        if e.snap then e.snap.Visible=false end
        for _, l in ipairs(e.bones) do l.Visible=false end
        for _, l in ipairs(e.bonesVis) do l.Visible=false end
        applyChams(e, false)
        return
    end
    local color = pickColor(e.player, enemy, invul)
    drawBox(e, cx, cy, width, height, color, 0)

    e.bb.Visible = true
    e.bb.Position = UDim2.fromOffset(cx, cy)
    e.bb.Size = UDim2.fromOffset(width, height)

    -- name
    e.name.Visible = O.EspName
    e.name.TextSize = O.EspTextSize
    e.name.TextColor3 = invul and MV.col(O.EspInvulCol)
        or (enemy and MV.col(O.EspNameCol) or MV.col(O.EspAllyCol))
    local nameText = e.player.DisplayName or e.player.Name
    e.name.Text = nameText
    e.chip.Visible = O.EspChip and O.EspName

    -- dist
    e.dist.Visible = O.EspDist or O.EspHealthNum
    e.dist.Position = UDim2.new(0.5,0,1,-2)
    local dist = (root.Position - workspace.CurrentCamera.CFrame.Position).Magnitude
    local t = string.format("%.0fm", dist/3)
    if O.EspHealthNum then
        t = t..string.format("  %d hp", math.floor(tonumber(character:GetAttribute("Health")) or humanoid.Health))
    end
    e.dist.Text = t
    e.dist.TextColor3 = MV.col(O.EspDetailCol)
    e.dist.TextSize = math.max(O.EspTextSize-2,8)

    -- hp
    e.hpBack.Visible = O.EspHealth
    if O.EspHealth then
        e.hpBack.Size = UDim2.fromOffset(4, height)
        local h = tonumber(character:GetAttribute("Health")) or humanoid.Health or 100
        local m = tonumber(character:GetAttribute("MaxHealth")) or 100
        local f = math.clamp(h/m, 0, 1)
        e.hp.Size = UDim2.new(0, 2, f, 0)
        e.hp.BackgroundColor3 = Color3.fromRGB(255*(1-f), 255*f, 0)
    end

    -- head dot
    if O.EspHead then
        local head = character:FindFirstChild("Head")
        local p, ok, z = project(head and head.Position or root.Position)
        if p and ok and z>0 then
            local s = math.clamp(90/z, 3, 14)
            e.head.Size = UDim2.fromOffset(s,s)
            e.head.Position = UDim2.fromOffset(p.X, p.Y)
            e.head.BackgroundColor3 = color
            e.head.Visible = true
        else
            e.head.Visible = false
        end
    else
        e.head.Visible = false
    end

    -- snap
    if O.EspSnap then
        local cam = workspace.CurrentCamera
        local origin = Vector2.new(cam.ViewportSize.X*0.5, cam.ViewportSize.Y)
        local target = Vector2.new(cx, bottomY2)
        local d = target - origin
        if not e.snap then
            e.snap = MV.Mk("Frame", layer, {
                BackgroundColor3 = color, BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5,0.5), ZIndex = 3,
            })
        end
        e.snap.Size = UDim2.fromOffset(math.max(d.Magnitude,1), 1)
        e.snap.Position = UDim2.fromOffset((origin.X+target.X)*0.5, (origin.Y+target.Y)*0.5)
        e.snap.Rotation = math.deg(math.atan2(d.Y, d.X))
        e.snap.BackgroundColor3 = color
        e.snap.Visible = true
    elseif e.snap then
        e.snap.Visible = false
    end

    drawSkeleton(e, enemy)
    applyChams(e, O.EspChams, color)
end

function MV.StepEsp()
    if not O.Esp then
        for _, e in pairs(State.EspEntries) do
            e.box.Visible=false; e.bb.Visible=false; e.head.Visible=false
            if e.snap then e.snap.Visible=false end
            for _, l in ipairs(e.bones) do l.Visible=false end
            for _, l in ipairs(e.bonesVis) do l.Visible=false end
            applyChams(e, false)
        end
        return
    end
    for p, e in pairs(State.EspEntries) do
        if not p.Parent or not p.Character then
            destroyEntry(e)
            State.EspEntries[p] = nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local enemy = MV.IsEnemy(player)
            if enemy or O.EspTeam then
                local e = State.EspEntries[player]
                if not e or e.character ~= player.Character then
                    destroyEntry(e)
                    e = createEntry(player)
                    State.EspEntries[player] = e
                end
                e.character = player.Character
                pcall(drawOne, e, enemy)
            else
                local e = State.EspEntries[player]
                if e then
                    e.box.Visible=false; e.bb.Visible=false; e.head.Visible=false
                    if e.snap then e.snap.Visible=false end
                    for _, l in ipairs(e.bones) do l.Visible=false end
                    for _, l in ipairs(e.bonesVis) do l.Visible=false end
                    applyChams(e, false)
                end
            end
        end
    end
end
