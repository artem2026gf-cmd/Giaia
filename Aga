-- NADES
-- ============================================================

local arcLayer = MV.Mk("Frame", State.EspScreen, {
    Size = UDim2.fromScale(1,1), BackgroundTransparency = 1, ZIndex = 6,
})
State.NadeArcLayer = arcLayer
State.NadeArcPool = {}
State.NadePoints = {}
State.NadeTracker = {}

local SPEC = {
    ["Flashbang"]={fuse=1.7,floor=false},["HE Grenade"]={fuse=1.6,floor=false},
    ["Smoke Grenade"]={fuse=1.6,floor=false},["Decoy Grenade"]={fuse=1.6,floor=false},
    ["Molotov"]={fuse=nil,floor=true},["Incendiary Grenade"]={fuse=nil,floor=true},
}

local function nadeFuse(name)
    if not name then return 1.6, false end
    local lower = string.lower(name)
    for k, v in pairs(SPEC) do
        if string.find(lower, string.lower(k), 1, true) then
            local fuse = v.fuse
            if (O.NadeFuseOverride or 0) > 0 and not v.floor then
                fuse = O.NadeFuseOverride
            end
            return fuse, v.floor
        end
    end
    return 1.6, false
end

local function equippedNadeName()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    for _, ch in ipairs(cam:GetChildren()) do
        if ch:IsA("Model") then
            local lower = string.lower(ch.Name)
            if lower:find("nade") or lower:find("grenade") or lower:find("flash")
                or lower:find("smoke") or lower:find("molot")
                or lower:find("incend") or lower:find("decoy") or lower:find("frag") then
                return ch.Name
            end
        end
    end
    return nil
end

local function simulate(origin, velocity, name, points, ignore)
    points = points or {}
    for i = #points, 1, -1 do points[i] = nil end
    local dt = 1/60
    local gravity = Vector3.new(0, -workspace.Gravity, 0)
    local elasticity, sleepVel = 0.42, 6
    local fuse, onFloor = nadeFuse(name)
    local pos, vel = origin, velocity
    local bounces, elapsed = 0, 0
    local stopIndex, stopTime, stopWhy
    points[1] = pos
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = ignore or {}
    for _ = 1, 420 do
        local nv = vel + gravity*dt
        local np = pos + nv*dt
        if fuse and elapsed >= fuse then
            stopIndex = #points; stopTime = elapsed; stopWhy = "FUSE"; break
        end
        local hit = workspace:Raycast(pos, np-pos, rp)
        elapsed = elapsed + dt
        if hit then
            pos = hit.Position + hit.Normal*0.05
            points[#points+1] = pos
            if onFloor and hit.Normal.Y > 0.7 then
                stopIndex = #points; stopTime = elapsed; stopWhy = "FLOOR"; break
            end
            vel = (nv - 2*nv:Dot(hit.Normal)*hit.Normal)*elasticity
            bounces = bounces + 1
            if bounces > 4 then stopWhy = "BOUNCES"; break end
            if vel.Magnitude < sleepVel and not fuse then stopWhy = "REST"; break end
        else
            pos, vel = np, nv
            points[#points+1] = pos
        end
    end
    if not stopIndex then stopIndex = #points; stopTime = elapsed; stopWhy = stopWhy or "REST" end
    return points, stopIndex, stopTime, stopWhy
end

local function arcLineGet(index)
    local f = State.NadeArcPool[index]
    if not f then
        f = MV.Mk("Frame", arcLayer, {
            BackgroundColor3 = MV.col(O.NadeArcColor),
            BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5), ZIndex = 6,
        })
        State.NadeArcPool[index] = f
    end
    f.Visible = true
    return f
end

local markRing, markLabel
local function ensureMark()
    if not markRing or not markRing.Parent then
        markRing = MV.Mk("Frame", arcLayer, {
            Size = UDim2.fromOffset(18,18),
            AnchorPoint = Vector2.new(0.5,0.5),
            BackgroundTransparency = 1, Visible = false, ZIndex = 7,
        })
        MV.Mk("UICorner", markRing, { CornerRadius = UDim.new(1,0) })
        MV.Mk("UIStroke", markRing, {
            Color = MV.col(O.NadeArcColor), Thickness = 2, Transparency = 0.2,
        })
        markLabel = MV.Mk("TextLabel", arcLayer, {
            Size = UDim2.fromOffset(220,14),
            AnchorPoint = Vector2.new(0.5,0.5),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code, TextSize = 11,
            TextColor3 = MV.col(O.NadeArcColor),
            TextStrokeTransparency = 0.3, Visible = false, ZIndex = 7,
        })
    end
end

local function stepArc()
    if not O.NadeArc then
        for _, f in pairs(State.NadeArcPool) do f.Visible = false end
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
        return
    end
    local name = equippedNadeName()
    if not name and not O.NadeAlways then
        for _, f in pairs(State.NadeArcPool) do f.Visible = false end
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
        return
    end
    name = name or "HE Grenade"
    local cam = workspace.CurrentCamera
    if not cam then return end
    local origin = cam.CFrame.Position + cam.CFrame.LookVector*2
    local direction = (cam.CFrame.LookVector + Vector3.new(0,0.18,0)).Unit
    local velocity = direction * 50
    local points, stop, stopTime, stopWhy = simulate(
        origin, velocity, name, State.NadePoints, {LP.Character, cam})

    local used = 0
    local prevS, prevOK = MV.Project(points[1])
    for i = 2, stop do
        local s, ok = MV.Project(points[i])
        if prevS and s and prevOK and ok then
            used = used + 1
            local f = arcLineGet(used)
            local d = s - prevS
            f.Size = UDim2.fromOffset(math.max(d.Magnitude,1), 2)
            f.Position = UDim2.fromOffset((prevS.X+s.X)*0.5, (prevS.Y+s.Y)*0.5)
            f.Rotation = math.deg(math.atan2(d.Y, d.X))
            local fade = i/#points
            f.BackgroundColor3 = MV.col(O.NadeArcColor)
            f.BackgroundTransparency = 0.15 + fade*0.35
        end
        prevS, prevOK = s, ok
    end
    for i = used+1, #State.NadeArcPool do
        State.NadeArcPool[i].Visible = false
    end

    local screen, ok = MV.Project(points[stop])
    if screen and ok then
        ensureMark()
        markRing.Position = UDim2.fromOffset(screen.X, screen.Y)
        markRing.Visible = O.NadeMark
        if O.NadeLabel then
            markLabel.Text = string.format("%s  %s  %.2fs",
                string.upper(name), stopWhy or "REST", stopTime or 0)
            markLabel.Position = UDim2.fromOffset(screen.X, screen.Y+20)
            markLabel.Visible = true
        else
            markLabel.Visible = false
        end
    else
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
    end
end

local function stepTrack()
    if not O.NadeTrack then return end
    local tagged = CollectionService:GetTagged("Grenade")
    for _, model in ipairs(tagged) do
        if model:IsA("Model") and model.Parent then
            local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if part then
                local record = State.NadeTracker[model]
                if not record then
                    record = {at=tick(), position=part.Position, velocity=Vector3.zero,
                        points={}, name=model:GetAttribute("GrenadeName")}
                    State.NadeTracker[model] = record
                else
                    local gap = tick() - record.at
                    if gap > 0.005 then
                        local sampled = (part.Position - record.position)/gap
                        record.velocity = record.velocity:Lerp(sampled, 0.45)
                        record.at = tick()
                        record.position = part.Position
                    end
                end
            end
        end
    end
    for model in pairs(State.NadeTracker) do
        if not model.Parent then State.NadeTracker[model] = nil end
    end
end

-- ============================================================
-- BOMBS
-- ============================================================

State.WorldMarks = {}

local function worldMark(instance, text, color, lines)
    if not instance or not instance.Parent then return end
    local mark = State.WorldMarks[instance]
    if not mark or not mark.gui.Parent then
        local gui = MV.Mk("BillboardGui", State.EspScreen, {
            Name = "MVWorldMark",
            Size = UDim2.fromOffset(140,20),
            StudsOffsetWorldSpace = Vector3.new(0, 1.6, 0),
            AlwaysOnTop = true, LightInfluence = 0,
        })
        local label = MV.Mk("TextLabel", gui, {
            Size = UDim2.fromScale(1,1), BackgroundTransparency = 1,
            Font = Enum.Font.Code, TextSize = 11,
            TextStrokeTransparency = 0.35,
            TextXAlignment = Enum.TextXAlignment.Center, Text = "",
        })
        mark = {gui=gui, label=label}
        State.WorldMarks[instance] = mark
    end
    local part = instance:IsA("BasePart") and instance
        or (instance:IsA("Model") and (instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")))
    mark.gui.Adornee = part
    mark.gui.Enabled = part ~= nil
    mark.gui.Size = UDim2.fromOffset(180, lines and (lines*13+6) or 20)
    mark.label.Text = text
    mark.label.TextColor3 = color
    mark.label.TextSize = lines and 10 or 11
    mark.seen = true
end

local function stepBombs()
    local drops = O.BombDropEsp
    local bombOnly = O.BombEsp
    if not drops and not bombOnly then
        for instance, mark in pairs(State.WorldMarks) do
            pcall(function() mark.gui:Destroy() end)
            State.WorldMarks[instance] = nil
        end
        return
    end
    for _, mark in pairs(State.WorldMarks) do mark.seen = false end

    if drops then
        for _, model in ipairs(CollectionService:GetTagged("WeaponDropped")) do
            if model.Parent then
                local named = model:GetAttribute("Weapon")
                if type(named) ~= "string" or named == "" then named = model.Name end
                worldMark(model, named, named=="C4"
                    and Color3.fromRGB(255,180,60) or Color3.fromRGB(200,200,120))
            end
        end
    end

    local tagged = CollectionService:GetTagged("Bomb")
    local bombModel = tagged and tagged[1]
    if (drops or bombOnly) and bombModel and bombModel.Parent then
        local raw = bombModel:GetAttribute("BombPlanted")
        local at, fuse
        if type(raw) == "string" then
            at = tonumber(string.match(raw, '"Time"%s*:%s*(%-?[%d%.eE+]+)'))
            fuse = tonumber(string.match(raw, '"TimeUntilExplode"%s*:%s*(%-?[%d%.eE+]+)'))
        end
        local now = workspace:GetServerTimeNow()
        fuse = fuse or 40
        at = at or now
        local left = math.max(at + fuse - now, 0)
        local defused = bombModel:GetAttribute("Defused") == true
        local gone = bombModel:GetAttribute("Exploding") == true
            or bombModel:GetAttribute("Exploded") == true
        local caption, colour
        if defused then
            caption = "C4  DEFUSED"
            colour = Color3.fromRGB(120,230,140)
        elseif gone then
            caption = "C4  GONE"
            colour = Color3.fromRGB(200,200,200)
        else
            caption = string.format("C4  %d:%04.1f", math.floor(left/60), left%60)
            colour = left < 10 and Color3.fromRGB(255,70,70)
                or Color3.fromRGB(255,120,60)
        end
        worldMark(bombModel, caption, colour, 1)
    end

    if drops then
        for _, item in ipairs(CollectionService:GetTagged("Hostage")) do
            if item.Parent then
                worldMark(item, "hostage", Color3.fromRGB(120,200,255))
            end
        end
    end

    for instance, mark in pairs(State.WorldMarks) do
        if not mark.seen or not instance.Parent then
            pcall(function() mark.gui:Destroy() end)
            State.WorldMarks[instance] = nil
        end
    end
end

