local function fxShards(at, n, color, life)
    for _=1,n do
        local p = fxPart()
        p.Size = Vector3.new(0.12, 0.12, math.random(6,16)/10)
        local dir = Vector3.new(math.random()-0.5, math.random()*0.8, math.random()-0.5)
        if dir.Magnitude < 0.01 then dir = Vector3.new(0,1,0) end
        dir = dir.Unit
        p.CFrame = CFrame.lookAt(at, at + dir)
        p.Color = color
        fxAdd(p, life, "shard")
        local last = fxLive[#fxLive]
        last.dir = dir; last.origin = at; last.speed = math.random(14,30)
    end
end
local function fxBeam(a, b, thick, color, life)
    local d = b - a
    local len = d.Magnitude
    if len < 0.05 then return end
    local p = fxPart()
    p.Size = Vector3.new(thick, thick, len)
    p.CFrame = CFrame.lookAt(a + d*0.5, b)
    p.Color = color
    fxAdd(p, life, "fade")
end

local function stepFxParts()
    local now = tick()
    for i=#fxLive,1,-1 do
        local e = fxLive[i]
        local age = (now-e.born)/math.max(e.life,0.05)
        if age >= 1 or not e.part.Parent then
            if e.part then
                e.part.Parent = nil
                if #fxPool < 80 then fxPool[#fxPool+1] = e.part end
            end
            fxLive[i] = nil
        else
            local p = e.part
            if e.style == "ring" then
                local grow = p.Size.Y * (1 + age*0.02)
                p.Size = Vector3.new(0.2, grow, grow)
                p.Transparency = age
            elseif e.style == "burst" then
                local grow = p.Size.Y * (1 + age*0.03)
                p.Size = Vector3.new(grow, grow, grow)
                p.Transparency = 0.25 + age*0.75
                local l = p:FindFirstChildOfClass("PointLight")
                if l then l.Brightness = 6*(1-age)*(1-age) end
            elseif e.style == "column" then
                p.Transparency = age
            elseif e.style == "shard" then
                local travel = e.speed*(now-e.born)
                local drop = Vector3.new(0, -18*(now-e.born)^2, 0)
                p.CFrame = CFrame.lookAt(e.origin+e.dir*travel+drop,
                    e.origin+e.dir*(travel+1))
                p.Transparency = age
            else
                p.Transparency = age
            end
        end
    end
end

function MV.KillFx(worldPos)
    if not O.KillFx then return end
    local c = MV.col(O.KillColor)
    fxSphere(worldPos, O.KillScale*0.52, c, O.KillLife*0.8)
    if O.KillRing then
        fxRing(worldPos-Vector3.new(0,1.6,0), O.KillScale*0.75, c, O.KillLife*1.7)
        fxRing(worldPos-Vector3.new(0,1.58,0), O.KillScale*1.2, c, O.KillLife*2.2)
    end
    if O.KillShards then fxShards(worldPos, math.clamp(O.KillShardsN,4,32), c, O.KillLife*1.7) end
    if O.KillPillar then fxColumn(worldPos-Vector3.new(0,1.8,0), O.KillPillarH,
        math.clamp(O.KillScale*0.46,1.1,10), c, O.KillLife*1.8) end
end

function MV.HitFx(worldPos)
    if not O.HitFx then return end
    local c = MV.col(O.HitFxColor)
    local cam = workspace.CurrentCamera
    local from = cam and (cam.CFrame.Position + cam.CFrame.LookVector*2) or worldPos
    if O.HitFxStyle == "bolt" or O.HitFxStyle == "storm" then
        fxBeam(from, worldPos, 0.15, Color3.new(1,1,1), O.HitFxLife)
        fxBeam(from, worldPos, 0.4, c, O.HitFxLife*0.85)
    end
    if O.HitFxStyle == "beam" or O.HitFxStyle == "storm" then
        fxBeam(from, worldPos, 0.2*O.HitFxScale, c, O.HitFxLife)
    end
    fxSphere(worldPos, 0.35*O.HitFxScale, c, O.HitFxLife*0.7)
end

-- FOV circle
local fovCircle
