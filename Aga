function MV.Mk(class, parent, props)
    local it = Instance.new(class)
    for k,v in pairs(props or {}) do it[k] = v end
    if parent then it.Parent = parent end
    return it
end

function MV.Connect(signal, handler)
    local c = signal:Connect(handler)
    table.insert(MV.State.Connections, c)
    return c
end

function MV.Try(label, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then warn("[Mario Visuals] "..label..":", err) end
    return ok
end

function MV.Log(msg)
    warn("[Mario Visuals] "..tostring(msg))
end

function MV.HttpGet(url)
    local ok, body = pcall(game.HttpGet, game, url)
    if ok and type(body)=="string" then return body end
    local req = request or http_request or (syn and syn.request)
    if not req then error("no http") end
    local sent, resp = pcall(req, {Url=url, Method="GET"})
    if not sent then error(resp) end
    local status = type(resp)=="table" and tonumber(resp.StatusCode)
    if status ~= 200 or type(resp.Body) ~= "string" then
        error("http status "..tostring(status))
    end
    return resp.Body
end

function MV.LoadLibrary(url)
    local got, source = pcall(MV.HttpGet, url)
    local whole = got and type(source)=="string"
        and source:sub(-64):find("return Library%s*$") ~= nil
    if not whole then
        MV.Log("library download failed: "..tostring(source))
        return nil
    end
    local chunk, err = loadstring(source)
    if type(chunk) ~= "function" then
        MV.Log("library loadstring: "..tostring(err))
        return nil
    end
    local ran, lib = pcall(chunk)
    if ran and type(lib)=="table" then return lib end
    MV.Log("library execute: "..tostring(lib))
    return nil
end

-- ============================================================
-- decode helper
-- ============================================================

local decoded = {}
function MV.Decode(raw)
    if type(raw) ~= "string" then return nil end
    if decoded[raw] == nil then
        local ok, val = pcall(HttpService.JSONDecode, HttpService, raw)
        decoded[raw] = ok and val or false
    end
    return decoded[raw] or nil
end

