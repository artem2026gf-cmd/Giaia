-- skeleton
-- ============================================================

local function drawBonePair(a, b)
    local pa, va, za = project(a.Position)
    local pb, vb, zb = project(b.Position)
    if not pa or not pb or not va or not vb or za<=0 or zb<=0 then return nil end
    return pa, pb
end

function MV.DrawSkeleton(entry, enemy)
    local e = entry
    if not O.EspSkel then
        for _, l in ipairs(e.bones) do l.Visible = false end
        for _, l in ipairs(e.bonesVis) do l.Visible = false end
        return
    end
    local character = e.character
    local mainColor = enemy and col(O.EspEnemyCol) or col(O.EspAllyCol)
    local visColor = col("lime")
    local used = 0
    local usedVis = 0

    for _, pair in ipairs(BONES_R15) do
        local a = character:FindFirstChild(pair[1])
        local b = character:FindFirstChild(pair[2])
        if a and b then
            local pa, pb = drawBonePair(a, b)
            if pa and pb then
                used = used + 1
                local line = e.bones[used]
                if not line then
                    line = Mk("Frame", layer, {
                        BorderSizePixel = 0,
                        AnchorPoint = Vector2.new(0.5,0.5),
                        ZIndex = 4,
                    })
                    e.bones[used] = line
                end
                local delta = pb - pa
                line.Size = UDim2.fromOffset(
                    math.max(delta.Magnitude,1), O.EspSkelThick)
                line.Position = UDim2.fromOffset(
                    (pa.X+pb.X)*0.5, (pa.Y+pb.Y)*0.5)
                line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                line.BackgroundColor3 = mainColor
                line.Visible = true

                if O.EspSkelVis then
                    local visible = MV.PartVisible(a, character)
                        or MV.PartVisible(b, character)
                    if visible then
                        usedVis = usedVis + 1
                        local vline = e.bonesVis[usedVis]
                        if not vline then
                            vline = Mk("Frame", layer, {
                                BorderSizePixel = 0,
                                AnchorPoint = Vector2.new(0.5,0.5),
                                ZIndex = 5,
                            })
                            e.bonesVis[usedVis] = vline
                        end
                        vline.Size = UDim2.fromOffset(
                            math.max(delta.Magnitude,1), O.EspSkelThick+0.5)
                        vline.Position = UDim2.fromOffset(
                            (pa.X+pb.X)*0.5, (pa.Y+pb.Y)*0.5)
                        vline.Rotation = line.Rotation
                        vline.BackgroundColor3 = visColor
                        vline.BackgroundTransparency = 0.2
                        vline.Visible = true
                    end
                end
            end
        end
    end
    for i = used+1, #e.bones do e.bones[i].Visible = false end
    for i = usedVis+1, #e.bonesVis do e.bonesVis[i].Visible = false end
end
-- Lua | MarioVisuals/03_Esp_Step.lua | главный per-frame loop для ESP

local O = MV.Options
local State = MV.State
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local function pickColor(player, character, enemy, invul)
    if O.EspRgbForce and O.EspRgb then
        local hue = (tick()*0.3) % 1
        return Color3.fromHSV(hue, 0.9, 1)
    end
    if invul then return MV.col(O.EspInvulCol) end
    if O.EspTarget and State.AimTarget == player then
        return MV.col(O.EspTargetCol)
    end
    if enemy then return MV.col(O.EspEnemyCol) end
    return MV.col(O.EspAllyCol)
end

local function drawOne(entry, enemy)
    local character = entry.character
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health<=0 then return end

    local invul = MV.IsInvul(character, entry.player)

    local bounds = MV.EspBounds(character, root)
    if not bounds then
        entry.box.Visible = false
        entry.bb.Visible = false
        entry.head.Visible = false
        if entry.snap then entry.snap.Visible = false end
        for _, l in ipairs(entry.bones) do l.Visible = false end
        for _, l in ipairs(entry.bonesVis) do l.Visible = false end
        MV.ApplyChams(entry, false)
        return
    end

    local left, topY, right, bottomY2, onScreen,
        width, height, cx, cy = MV.EspBounds(character, root)

    if not onScreen then
