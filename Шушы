local function buildPreview(point)
    clearPreviewClones()
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.MaxParts = 260
    params.FilterDescendantsInstances = { LP.Character, Workspace.CurrentCamera }

    local radius = math.clamp(O.NadePreviewRadius, 10, 60)
    local ok, parts = pcall(function()
        return Workspace:GetPartBoundsInRadius(point, radius, params)
    end)
    if not ok or not parts then return end

    local budget = 140
    for _, part in ipairs(parts) do
        if budget <= 0 then break end
        if part:IsA("BasePart") and part.Transparency < 0.9
            and part.Size.Magnitude < 400 then
            budget = budget - 1
            local clone = Instance.new("Part")
            clone.Anchored = true
            clone.CanCollide = false
            clone.CanQuery = false
            clone.CastShadow = false
            clone.Size = part.Size
            clone.CFrame = part.CFrame
            clone.Color = part.Color
            clone.Material = part.Material
            clone.Transparency = part.Transparency
            clone.Parent = previewWorld
            previewClones[#previewClones+1] = clone
        end
    end
end

-- ============================================================
-- arc step
-- ============================================================

local function stepArc()
    if not O.NadeArc then
        for _, f in pairs(State.NadeArcPool) do f.Visible = false end
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
        if previewFrame then previewFrame.Visible = false end
        return
    end

    local nadeName = equippedNadeName()
    if not nadeName and not O.NadeAlways then
        for _, f in pairs(State.NadeArcPool) do f.Visible = false end
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
        if previewFrame then previewFrame.Visible = false end
        return
    end

    nadeName = nadeName or "HE Grenade"

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local cf = cam.CFrame
    local origin = cf.Position + cf.LookVector * 2
    local direction = (cf.LookVector + Vector3.new(0, 0.18, 0)).Unit
    local velocity = direction * 50

    local points = State.NadePoints
    local stop, stopTime, stopWhy = simulate(origin, velocity, nadeName,
        points, { LP.Character, cam })

    -- render arc
    local used = 0
    local prevScreen, prevOk = project(points[1])
    for i = 2, stop do
        local screen, ok = project(points[i])
        if prevScreen and screen and prevOk and ok then
            used = used + 1
            local line = arcLineGet(used)
            local delta = screen - prevScreen
            line.Size = UDim2.fromOffset(math.max(delta.Magnitude,1), 2)
            line.Position = UDim2.fromOffset(
                (prevScreen.X+screen.X)*0.5, (prevScreen.Y+screen.Y)*0.5)
            line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            local fade = i / #points
            line.BackgroundColor3 = MV.col(O.NadeArcColor)
            line.BackgroundTransparency = 0.15 + fade * 0.35
        end
        prevScreen, prevOk = screen, ok
    end
    for i = used+1, #State.NadeArcPool do
        arcLinePut(State.NadeArcPool[i])
    end

    -- landing mark
    local landingScreen, landingOk = project(points[stop])
    if landingScreen and landingOk then
        ensureMark()
        markRing.Position = UDim2.fromOffset(landingScreen.X, landingScreen.Y)
        markRing.Visible = O.NadeMark
        if O.NadeLabel then
            markLabel.Text = string.format("%s  %s  %.2fs",
                string.upper(nadeName), stopWhy or "REST", stopTime or 0)
            markLabel.Position = UDim2.fromOffset(landingScreen.X, landingScreen.Y + 20)
            markLabel.Visible = true
        else
            markLabel.Visible = false
        end
    else
        if markRing then markRing.Visible = false end
        if markLabel then markLabel.Visible = false end
    end

    -- impact preview
    if O.NadePreview then
        ensurePreview()
        previewFrame.Visible = true
        local dot = previewWorld:FindFirstChild("Dot")
        if dot then
            dot.Position = points[stop]
            dot.Color = (stopWhy == "FLOOR") and Color3.fromRGB(255,140,60)
                or Color3.fromRGB(255,225,80)
        end
        local angle = math.rad(O.NadePreviewAngle)
        local distance = math.clamp(O.NadePreviewRadius, 10, 60) * 0.85
        previewCam.CFrame = CFrame.lookAt(
            points[stop] + Vector3.new(
                math.sin(angle)*distance,
                distance*0.6,
                math.cos(angle)*distance),
            points[stop])
        buildPreview(points[stop])
        previewInfo.Text = string.format("%s  %s  %.2fs",
            string.upper(nadeName), stopWhy or "REST", stopTime or 0)
    elseif previewFrame then
        previewFrame.Visible = false
    end
end

