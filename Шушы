local function createEntry(player)
    local box = MV.Mk("Frame", layer, {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Visible = false, ZIndex = 3,
        AnchorPoint = Vector2.new(0.5,0.5),
    })
    local fill = MV.Mk("Frame", box, {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
    })
    local edges = {}
    for i=1,8 do
        edges[i] = MV.Mk("Frame", box, {
            BackgroundColor3 = MV.col(O.EspEnemyCol),
            BorderSizePixel = 0, ZIndex = 3,
        })
        MV.Mk("UIStroke", edges[i], {
            Color = Color3.new(0,0,0), Thickness = 1, Transparency = 0.35,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        })
    end

    local bb = MV.Mk("Frame", layer, {
        Size = UDim2.fromOffset(1,1),
        BackgroundTransparency = 1, Visible = false,
        ZIndex = 5, AnchorPoint = Vector2.new(0.5,0.5),
    })
    local name = MV.Mk("TextLabel", bb, {
        AnchorPoint = Vector2.new(0.5,1),
        Position = UDim2.new(0.5,0,0,-2),
        Size = UDim2.fromOffset(200,16),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code, TextSize = O.EspTextSize,
        TextColor3 = MV.col(O.EspNameCol),
        TextStrokeTransparency = 0.2, Text = "",
    })
    local dist = MV.Mk("TextLabel", bb, {
        AnchorPoint = Vector2.new(0.5,0),
        Size = UDim2.fromOffset(200,13),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code, TextSize = math.max(O.EspTextSize-2,8),
        TextColor3 = MV.col(O.EspDetailCol),
        TextStrokeTransparency = 0.2, Text = "",
    })
    local chip = MV.Mk("Frame", bb, {
        Size = UDim2.fromOffset(140,20),
        Position = UDim2.new(0.5,0,0,-20),
        BackgroundColor3 = Color3.fromRGB(12,12,16),
        BackgroundTransparency = 0.5, Visible = false,
        ZIndex = 4, AnchorPoint = Vector2.new(0.5,1),
    })
    MV.Mk("UICorner", chip, { CornerRadius = UDim.new(0,6) })

    local hpBack = MV.Mk("Frame", bb, {
        Size = UDim2.fromOffset(4,1),
        AnchorPoint = Vector2.new(1,0), Position = UDim2.fromOffset(-4,0),
        BackgroundColor3 = Color3.fromRGB(4,4,4),
        BackgroundTransparency = 0.1, BorderSizePixel = 0,
        Visible = false, ZIndex = 5,
    })
    local hp = MV.Mk("Frame", hpBack, {
        Size = UDim2.new(0,2,1,0),
        AnchorPoint = Vector2.new(0.5,1),
        Position = UDim2.new(0.5,0,1,0),
        BackgroundColor3 = MV.col("green"),
