-- ============================================================
-- bomb state
-- ============================================================

local function bombState()
    local tagged = CollectionService:GetTagged("Bomb")
    local model = tagged and tagged[1]
    if not model or not model.Parent then return nil end

    local raw = model:GetAttribute("BombPlanted")
    local at, fuse
    if type(raw) == "string" then
        at = tonumber(string.match(raw, '"Time"%s*:%s*(%-?[%d%.eE+]+)'))
        fuse = tonumber(string.match(raw, '"TimeUntilExplode"%s*:%s*(%-?[%d%.eE+]+)'))
    end

    local now = Workspace:GetServerTimeNow()
    fuse = fuse or 40
    at = at or now
    local explodeAt = at + fuse
    local state = {
        model = model,
        fuse = fuse,
        explodeAt = explodeAt,
        left = math.max(explodeAt - now, 0),
        defused = model:GetAttribute("Defused") == true,
        gone = model:GetAttribute("Exploding") == true
            or model:GetAttribute("Exploded") == true,
        reachable = model:GetAttribute("CanDefuse") == true,
        claimed = model:GetAttribute("IsGettingDefused") == true,
    }

    for _, player in ipairs(Players:GetPlayers()) do
        if player:GetAttribute("IsDefusingBomb") == true then
            state.defuser = player
            state.kit = player:GetAttribute("HasDefuseKit") == true
            state.need = state.kit and 5 or 10
            local began = tonumber(player:GetAttribute("DefuseStartTime"))
            if began then
                state.doneAt = began + state.need
                state.spent = math.max(now - began, 0)
                state.progress = math.clamp(state.spent / state.need, 0, 1)
                state.inTime = state.doneAt <= explodeAt
            end
            break
        end
    end

    return state
end

local function clockText(seconds)
    seconds = math.max(seconds or 0, 0)
    return string.format("%d:%04.1f", math.floor(seconds/60), seconds % 60)
end

local function bombCaption(state)
    local lines = {}
    local away = ""
    local cam = Workspace.CurrentCamera
    local part = state.model.PrimaryPart
        or state.model:FindFirstChildWhichIsA("BasePart")
    if cam and part then
        away = string.format("   %.0fm",
            (part.Position - cam.CFrame.Position).Magnitude / 3)
    end

    if state.defused then
        lines[1] = "C4  DEFUSED" .. away
    elseif state.gone then
        lines[1] = "C4  GONE"
    else
        lines[1] = "C4  " .. clockText(state.left) .. away
    end

    if not state.defused and not state.gone then
        if state.defuser then
            lines[#lines+1] = (state.defuser.DisplayName or state.defuser.Name)
                .. (state.kit and "  +kit" or "  no kit")
            if state.doneAt then
                lines[#lines+1] = string.format("%.1fs left  %s",
                    math.max(state.need - state.spent, 0),
                    state.inTime and "IN TIME" or "TOO LATE")
            end
        else
            lines[#lines+1] = state.claimed and "being defused"
                or (state.reachable and "nobody defusing" or "no defuser")
        end
    end

    return table.concat(lines, "\n"), #lines
end

-- ============================================================
-- world ESP (bomb + drops + hostages)
-- ============================================================

local function looksLikeDrop(instance)
    if instance:IsA("Tool") then return true end
    if instance:IsA("BasePart") then
        local ok, group = pcall(function() return instance.CollisionGroup end)
        if ok and group == "WeaponDropped" then return true end
    end
    if instance:IsA("Model") then
        local part = instance.PrimaryPart
            or instance:FindFirstChildWhichIsA("BasePart")
        if part then
            local ok, group = pcall(function() return part.CollisionGroup end)
            if ok and group == "WeaponDropped" then return true end
        end
    end
    local lower = string.lower(instance.Name)
    return lower:find("dropped", 1, true) ~= nil
end

local function stepWorldEsp()
    local drops = O.BombDropEsp
    local bombOnly = O.BombEsp
    if not drops and not bombOnly then
        for instance, mark in pairs(State.WorldMarks) do
            pcall(function() mark.gui:Destroy() end)
            State.WorldMarks[instance] = nil
        end
        return
    end

    for _, mark in pairs(State.WorldMarks) do mark.seen = false end

    -- dropped weapons
    if drops then
        for _, model in ipairs(CollectionService:GetTagged("WeaponDropped")) do
            if model.Parent then
                local named = model:GetAttribute("Weapon")
                if type(named) ~= "string" or named == "" then
                    named = model.Name
                end
                local isC4 = named == "C4"
                worldMark(model, named,
                    isC4 and Color3.fromRGB(255,180,60)
                        or Color3.fromRGB(200,200,120))
            end
        end
    end

    -- bomb
    local bomb = (drops or bombOnly) and bombState() or nil
    State.BombState = bomb
    if bomb and bomb.model.Parent then
        local caption, lines = bombCaption(bomb)
        local colour = Color3.fromRGB(255,120,60)
        if bomb.defused then
            colour = Color3.fromRGB(120,230,140)
        elseif bomb.defuser then
            colour = (bomb.inTime == false) and Color3.fromRGB(255,90,90)
                or Color3.fromRGB(90,220,255)
        elseif bomb.left < 10 then
            colour = Color3.fromRGB(255,70,70)
        end
        worldMark(bomb.model, caption, colour, lines)
    end

    -- hostages
    if drops then
        for _, item in ipairs(CollectionService:GetTagged("Hostage")) do
            if item.Parent then
                worldMark(item, "hostage", Color3.fromRGB(120,200,255))
            end
        end
    end

    pruneWorldMarks()
end

