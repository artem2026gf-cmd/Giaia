        TextStrokeTransparency = 0.4,
        Visible = false, ZIndex = 7,
    })
    m = { ring = ring, edge = edge, label = label }
    State.NadeTrackMarks[index] = m
    return m
end

local CollectionService = game:GetService("CollectionService")

local function stepTrack()
    if not O.NadeTrack then
        for _, m in pairs(State.NadeTrackMarks) do
            m.ring.Visible = false
            m.label.Visible = false
        end
        return
    end

    local tagged = CollectionService:GetTagged("Grenade")
    local shown = 0
    local now = tick()

    for _, model in ipairs(tagged) do
        if shown >= 6 then break end
        if model:IsA("Model") and model.Parent then
            local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if part then
                local record = State.NadeTracker[model]
                if not record then
                    record = {
                        at = now, position = part.Position,
                        velocity = Vector3.zero, points = {},
                        name = model:GetAttribute("GrenadeName"),
                    }
                    State.NadeTracker[model] = record
                else
                    local gap = now - record.at
                    if gap > 0.005 then
                        local sampled = (part.Position - record.position) / gap
                        record.velocity = record.velocity:Lerp(sampled,
                            (record.velocity.Magnitude < 0.01) and 1 or 0.45)
                        record.at = now
                        record.position = part.Position
                    end
                end

                local name = record.name or model.Name
                local pts, stop, stopTime, why = simulate(
                    part.Position, record.velocity, name, record.points,
                    { model, LP.Character })
                record.stop = stop
                record.time = stopTime
                record.why = why

                local landing = pts[stop]
                if landing then
                    local screen, ok = project(landing)
                    if screen and ok then
                        shown = shown + 1
                        local m = trackMarkGet(shown)
                        m.ring.Position = UDim2.fromOffset(screen.X, screen.Y)
                        m.ring.Visible = true
                        m.edge.Color = (why == "FLOOR")
                            and Color3.fromRGB(255,140,60)
                            or Color3.fromRGB(255,225,80)
                        m.label.Text = string.format("%s  %.1fs",
                            string.upper(name), stopTime or 0)
                        m.label.Position = UDim2.fromOffset(screen.X, screen.Y + 18)
                        m.label.Visible = true
                    end
                end
            end
        end
    end

    for i = shown+1, #State.NadeTrackMarks do
        State.NadeTrackMarks[i].ring.Visible = false
        State.NadeTrackMarks[i].label.Visible = false
    end

    for model in pairs(State.NadeTracker) do
        if not model.Parent then State.NadeTracker[model] = nil end
    end
end

-- ============================================================
-- public step
-- ============================================================

function MV.StepNades()
    stepArc()
    stepTrack()
end
