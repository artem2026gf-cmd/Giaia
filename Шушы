function MV.StepEsp()
    if not O.Esp then
        for _, e in pairs(State.EspEntries) do
            e.box.Visible = false
            e.bb.Visible = false
            e.head.Visible = false
            if e.snap then e.snap.Visible = false end
            for _, l in ipairs(e.bones) do l.Visible = false end
            for _, l in ipairs(e.bonesVis) do l.Visible = false end
            MV.ApplyChams(e, false)
        end
        return
    end

    for p, e in pairs(State.EspEntries) do
        if not p.Parent or not p.Character then
            MV.DestroyEntry(e)
            State.EspEntries[p] = nil
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local character = player.Character
            if character then
                local enemy = MV.IsEnemy(player)
                if enemy or O.EspTeam then
                    local e = State.EspEntries[player]
                    if not e or e.character ~= character then
                        MV.DestroyEntry(e)
                        e = State.CreateEntry(player)
                        State.EspEntries[player] = e
                    end
                    e.character = character
                    local ok, err = pcall(drawOne, e, enemy)
                    if not ok then warn("[Visuals] draw:", err) end
                else
                    local e = State.EspEntries[player]
                    if e then
                        e.box.Visible = false
                        e.bb.Visible = false
                        e.head.Visible = false
                        if e.snap then e.snap.Visible = false end
                        for _, l in ipairs(e.bones) do l.Visible = false end
                        for _, l in ipairs(e.bonesVis) do l.Visible = false end
                        MV.ApplyChams(e, false)
                    end
                end
            end
        end
    end

    for p, e in pairs(State.EspEntries) do
        if not p.Parent then
            MV.DestroyEntry(e)
            State.EspEntries[p] = nil
        end
    end
end

