end
State.CreateEntry = createEntry

function MV.DestroyEntry(entry)
    if not entry then return end
    for _, obj in ipairs({ entry.box, entry.bb, entry.head, entry.chams }) do
        if obj then pcall(function() obj:Destroy() end) end
    end
    if entry.snap then pcall(function() entry.snap:Destroy() end) end
    for _, line in ipairs(entry.bones) do
        pcall(function() line:Destroy() end)
    end
    for _, line in ipairs(entry.bonesVis) do
        pcall(function() line:Destroy() end)
    end
end

-- ============================================================
-- box draw
-- ============================================================

function MV.DrawBox(entry, cx, cy, width, height, color, fade)
    local e = entry
    if not O.EspBox then e.box.Visible = false return end
    e.box.Visible = true
    e.box.Position = UDim2.fromOffset(cx, cy)
    e.box.Size = UDim2.fromOffset(width, height)

    local weight = math.max(math.floor(O.EspBoxThick), 1)
    local corner = O.EspBoxStyle == "corner"
    local arm = corner and math.max(width*math.clamp(O.EspBoxCorner,0.05,0.5),4) or 0

    for i, edge in ipairs(e.edges) do
        edge.BackgroundColor3 = color
        edge.BackgroundTransparency = fade or 0
        local horizontal = i <= 4
        local length = horizontal and ((arm>0) and arm or width)
            or ((arm>0) and arm or height)
        if horizontal then
            edge.Size = UDim2.fromOffset(length, weight)
            edge.Position = UDim2.fromOffset(
                (i%2==1) and 0 or (width-length),
                (i<=2) and 0 or (height-weight))
        else
            edge.Size = UDim2.fromOffset(weight, length)
            edge.Position = UDim2.fromOffset(
                (i%2==1) and 0 or (width-weight),
                (i<=6) and 0 or (height-length))
        end
    end
    e.fill.BackgroundColor3 = color
    e.fill.BackgroundTransparency = math.clamp(O.EspBoxFill, 0, 1)
    e.fill.Visible = O.EspBoxFill < 1
end

-- ============================================================
-- chams
-- ============================================================

function MV.ApplyChams(entry, enabled, color)
    local h = entry.chams
    if not h then return end
    if not enabled then
        if h.Enabled then h.Enabled = false end
        return
    end
    if entry.character and h.Adornee ~= entry.character then
        h.Adornee = entry.character
    end
    if h.FillColor ~= color then
        h.FillColor = color
        h.OutlineColor = color
    end
    h.FillTransparency = math.clamp(O.EspChamsFill, 0, 1)
    h.OutlineTransparency = math.clamp(O.EspChamsOut, 0, 1)
    h.DepthMode = O.EspChamsDepth and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
    if not h.Enabled then h.Enabled = true end
end

function MV.Log(msg)
    warn("[Mario Visuals] " .. tostring(msg))
end
-- Lua | MarioVisuals/02_Esp_Labels.lua | labels, hp, skeleton, snap, head dot

local O = MV.Options
local State = MV.State
local layer = State.EspLayer
local col = MV.col
local Mk = MV.Mk
local project = MV.Project

local BONES_R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function MV.PartVisible(part, character)
    local cam = workspace.CurrentCamera
    if not cam or not part then return false end
    local origin = cam.CFrame.Position
    local lp = game:GetService("Players").LocalPlayer
    rayParams.FilterDescendantsInstances = { lp.Character, character, cam }
    local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
    return hit == nil or hit.Instance:IsDescendantOf(character)
end

-- ============================================================
-- flags / ammo
-- ============================================================

function MV.EspFlags(pl, character)
    local flags = {}
    local armor = MV.Decode(pl and pl:GetAttribute("Armor"))
    local bomb  = MV.Decode(pl and pl:GetAttribute("Slot5"))
    if bomb and bomb.Weapon == "C4" then flags[#flags+1] = "C4" end
    if pl and pl:GetAttribute("HasDefuseKit") == true then flags[#flags+1] = "Kit" end
    if armor and type(armor.Type) == "string" and armor.Type:find("Helmet") then
        flags[#flags+1] = "Helmet"
    end
    if pl and pl:GetAttribute("IsSniperScoped") == true then flags[#flags+1] = "Scoped" end
    if character and character:GetAttribute("Dead") == true then flags[#flags+1] = "Dead" end
    return #flags > 0 and (" " .. table.concat(flags, " ")) or ""
end

function MV.ReadAmmo(player, character)
    local raw = MV.Decode(player and player:GetAttribute("CurrentEquipped"))
        or MV.Decode(character and character:GetAttribute("CurrentEquipped"))
    if type(raw) ~= "table" then return nil end
    local name = raw.DisplayName or raw.Name or raw.Identifier
    if not name and type(raw.Properties) == "table" then
        name = raw.Properties.DisplayName or raw.Properties.Name
    end
    local ammo = raw.Rounds or raw.Ammo or raw.CurrentAmmo
    local reserve = raw.Capacity or raw.ReserveAmmo or raw.Reserve
    return name, ammo, reserve
end

-- ============================================================
-- labels
-- ============================================================

function MV.DrawLabels(entry, enemy, invul, cx, cy, width, height, bottomY)
    local e = entry
    local pl = e.player
    local character = e.character
    local cam = workspace.CurrentCamera
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local nameColor = invul and col(O.EspInvulCol)
        or (enemy and col(O.EspNameCol) or col(O.EspAllyCol))
    local detailColor = invul and col(O.EspInvulCol) or col(O.EspDetailCol)

    e.name.Visible = O.EspName
    e.name.TextSize = O.EspTextSize
    e.name.TextColor3 = nameColor
    local nameText = pl.DisplayName or pl.Name
    if O.EspFlags then nameText = nameText .. MV.EspFlags(pl, character) end
    e.name.Text = nameText
    e.chip.Visible = O.EspChip and O.EspName
    e.chip.Size = UDim2.fromOffset(math.max(width+40, 90), 20)

    e.dist.Visible = O.EspDist or O.EspHealthNum or O.EspWeapon
    e.dist.Position = UDim2.new(0.5,0,1,-2)
    e.dist.TextSize = math.max(O.EspTextSize-2,8)
    e.dist.TextColor3 = detailColor
    local distance = (root.Position - cam.CFrame.Position).Magnitude
    local parts = { string.format("%.0fm", distance/3) }
    if O.EspHealthNum then
        local hp = tonumber(character:GetAttribute("Health")) or humanoid.Health
        parts[#parts+1] = string.format("%d hp", math.floor(hp))
    end
    if O.EspWeapon then
        local w, ammo, reserve = MV.ReadAmmo(pl, character)
        if w then
            local s = tostring(w)
            if ammo then
                s = s .. "  " .. tostring(ammo)
                if reserve then s = s .. "/" .. tostring(reserve) end
            end
            parts[#parts+1] = s
        end
    end
    e.dist.Text = table.concat(parts, "   ")

    e.hpBack.Visible = O.EspHealth
    if O.EspHealth then
        e.hpBack.Size = UDim2.fromOffset(4, height)
        local h = tonumber(character:GetAttribute("Health")) or humanoid.Health or 100
        local m = tonumber(character:GetAttribute("MaxHealth")) or 100
        local f = math.clamp(h/m, 0, 1)
        e.hp.Size = UDim2.new(0, 2, f, 0)
        e.hp.BackgroundColor3 = Color3.fromRGB(255*(1-f), 255*f, 0)
    end
end

-- ============================================================
-- head dot
-- ============================================================

function MV.DrawHeadDot(entry, color)
    local e = entry
    local character = e.character
    if not O.EspHead then e.head.Visible = false return end
    local head = character:FindFirstChild("Head")
    if not head then e.head.Visible = false return end
    local p, ok, z = project(head.Position)
    if p and ok and z > 0 then
        local size = math.clamp(90/z, 3, 14)
        e.head.Size = UDim2.fromOffset(size, size)
        e.head.Position = UDim2.fromOffset(p.X, p.Y)
        e.head.BackgroundColor3 = color
        e.head.Visible = true
    else
        e.head.Visible = false
    end
end

-- ============================================================
-- snapline
-- ============================================================

function MV.DrawSnapline(entry, cx, bottomY, color)
    local e = entry
    if not O.EspSnap then
        if e.snap then e.snap.Visible = false end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local origin = Vector2.new(cam.ViewportSize.X*0.5, cam.ViewportSize.Y)
    local target = Vector2.new(cx, bottomY)
    local delta = target - origin
    if not e.snap then
        e.snap = Mk("Frame", layer, {
            BackgroundColor3 = color, BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5,0.5), ZIndex = 3,
        })
    end
    e.snap.Size = UDim2.fromOffset(math.max(delta.Magnitude,1), 1)
    e.snap.Position = UDim2.fromOffset(
        (origin.X+target.X)*0.5, (origin.Y+target.Y)*0.5)
    e.snap.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    e.snap.BackgroundColor3 = color
    e.snap.Visible = true
end

