local function stepDefusePanel()
    if not O.BombTimer then
        if defusePanel then defusePanel.Visible = false end
        return
    end
    local bomb = State.BombState
    if not bomb or bomb.gone then
        if defusePanel then defusePanel.Visible = false end
        return
    end
    ensureDefusePanel()

    local title, detail, timeText = "Bomb status", "Waiting", ""
    local fill, colour = 0, MV.col("cyan")

    if bomb.defused then
        title = "Bomb defused"
        detail = "Round secured"
        timeText = "Complete"
        fill = 1
        colour = Color3.fromRGB(120,230,140)
    elseif bomb.defuser then
        title = "Defusing · " .. (bomb.defuser.DisplayName or bomb.defuser.Name)
        detail = bomb.kit and "Defuse kit equipped" or "Without a defuse kit"
        if bomb.doneAt then
            timeText = string.format("%.1f s", math.max(bomb.need - bomb.spent, 0))
            detail = detail .. (bomb.inTime and " · In time" or " · Too late")
            fill = bomb.progress or 0
        end
        colour = (bomb.inTime == false) and MV.col("red") or MV.col("cyan")
    else
        title = "Bomb planted"
        detail = bomb.claimed and "Defuse in progress"
            or (bomb.reachable and "no defuser" or "out of reach")
        fill = 1 - math.clamp(bomb.left / math.max(bomb.fuse, 1), 0, 1)
        if bomb.left < 10 then colour = Color3.fromRGB(255,70,70) end
    end

    if not bomb.defused and timeText == "" then
        timeText = string.format("%.1f s", bomb.left)
    end

    defuseGrip.Text = title
    defuseText.Text = detail
    defuseTime.Text = timeText
    defuseFill.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
    defuseFill.BackgroundColor3 = colour
    defuseAccent.BackgroundColor3 = colour
    defuseStroke.Color = colour
    defusePanel.Visible = true
end

-- ============================================================
-- auto defuse (native input group)
-- ============================================================

local function inputController()
    if State.NadeInputController then return State.NadeInputController end
    local root = ReplicatedStorage:FindFirstChild("Controllers")
    local mod = root and root:FindFirstChild("InputController")
    if not mod or not mod:IsA("ModuleScript") then return nil end
    local ok, ctrl = pcall(require, mod)
    if ok and type(ctrl) == "table" then
        State.NadeInputController = ctrl
        return ctrl
    end
    return nil
end

local function installAutoDefuseHold()
    local ctrl = inputController()
    if not ctrl or type(ctrl.isActionActive) ~= "function" then return nil end
    if not State.AutoDefuseWrapper then
        local original = ctrl.isActionActive
        local wrapper
        wrapper = function(name, ...)
            if name == "Use" and State.AutoDefuse.Holding then return true end
            return original(name, ...)
        end
        State.AutoDefuseController = ctrl
        State.AutoDefuseOriginal = original
        State.AutoDefuseWrapper = wrapper
        ctrl.isActionActive = wrapper
    end
    return State.AutoDefuseUse
end

local function stopAutoDefuse(cancel)
    local action = State.AutoDefuseUse
    if State.AutoDefuse.Holding and cancel and type(action) == "table"
        and type(action.Callback) == "function" then
        pcall(action.Callback, Enum.UserInputState.End, {})
    end
    State.AutoDefuse.Holding = false
    State.AutoDefuse.Bomb = nil
    State.AutoDefuse.PendingUntil = nil
    State.AutoDefuse.PulseAt = nil
end

local function startAutoDefuse(bomb)
    if State.AutoDefuse.Holding then return true end
    local action = installAutoDefuseHold()
    if not action then
        State.AutoDefuse.RetryAt = tick() + 1
        return false
    end
    State.AutoDefuse.Holding = true
    State.AutoDefuse.Bomb = bomb.model
    local ok = pcall(action.Callback, Enum.UserInputState.Begin, {})
    if not ok then
        State.AutoDefuse.Holding = false
        State.AutoDefuse.Bomb = nil
        State.AutoDefuse.RetryAt = tick() + 0.2
        return false
    end
    State.AutoDefuse.PendingUntil = tick() + 0.85
    State.AutoDefuse.PulseAt = tick() + 0.14
    return true
end

local function stepAutoDefuse()
    if not O.BombAutoDefuse then
        if State.AutoDefuse.Holding or State.AutoDefuseWrapper then
            stopAutoDefuse(true)
        end
        return
    end

    local now = tick()
    if now < (State.AutoDefuse.StepAt or 0) then return end
    State.AutoDefuse.StepAt = now + 0.04

    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and (character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart)
    if not character or not humanoid or not root then stopAutoDefuse(true) return end

    local canRun = Workspace:GetAttribute("Gamemode") == "Bomb Defusal"
        and LP:GetAttribute("Team") == "Counter-Terrorists"
        and humanoid.Health > 0
        and LP:GetAttribute("Dead") ~= true
    if not canRun then stopAutoDefuse(true) return end

    local bomb = State.BombState
    if not bomb or bomb.defused or bomb.gone then
        stopAutoDefuse(false)
        return
    end
    if State.AutoDefuse.Bomb and State.AutoDefuse.Bomb ~= bomb.model then
        stopAutoDefuse(true)
        return
    end

    local localDefusing = LP:GetAttribute("IsLocallyDefusingBomb") == true
        or LP:GetAttribute("IsDefusingBomb") == true
    local pending = State.AutoDefuse.Holding
        and now < (State.AutoDefuse.PendingUntil or 0)

    if localDefusing then
        State.AutoDefuse.PendingUntil = nil
        State.AutoDefuse.PulseAt = nil
        pending = false
    end
    if bomb.claimed and not localDefusing and not pending then
        stopAutoDefuse(true)
        return
    end

    if State.AutoDefuse.Holding then
        if localDefusing then return end
        if pending then
            if now >= (State.AutoDefuse.PulseAt or 0)
                and type(State.AutoDefuseUse) == "table"
                and type(State.AutoDefuseUse.Callback) == "function" then
                State.AutoDefuse.PulseAt = now + 0.14
                pcall(State.AutoDefuseUse.Callback,
                    Enum.UserInputState.Begin, {})
            end
            return
        end
        stopAutoDefuse(true)
        State.AutoDefuse.RetryAt = now + 0.12
        return
    end

    if bomb.reachable and not bomb.claimed
        and now >= (State.AutoDefuse.RetryAt or 0) then
        startAutoDefuse(bomb)
    end
end

-- ============================================================
-- bomb helpers to allow auto-defuse to find its action module
-- ============================================================

do
    local function loadUseAction()
        if type(State.AutoDefuseUse) == "table"
            and type(State.AutoDefuseUse.Callback) == "function" then
            return
        end
        local root = ReplicatedStorage:FindFirstChild("Controllers")
        local input = root and root:FindFirstChild("InputController")
        local actions = input and input:FindFirstChild("Actions")
        local use = actions and actions:FindFirstChild("Use")
        if not use or not use:IsA("ModuleScript") then return end
        local ok, action = pcall(require, use)
        if ok and type(action) == "table"
            and type(action.Callback) == "function" then
            State.AutoDefuseUse = action
        end
    end
    loadUseAction()
    -- если не нашли сразу — попробуем на следующем step
    RunService.Heartbeat:Connect(function()
        if not State.AutoDefuseUse then loadUseAction() end
    end)
end

-- ============================================================
-- public step
-- ============================================================

function MV.StepBombs()
    stepWorldEsp()
    stepDefusePanel()
    stepAutoDefuse()
end
