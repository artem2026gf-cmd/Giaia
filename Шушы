-- ============================================================
-- nade spec
-- ============================================================

local SPEC = {
    ["Flashbang"] = { fuse=1.7, floor=false, radius=0.35 },
    ["HE Grenade"] = { fuse=1.6, floor=false, radius=0.35 },
    ["Smoke Grenade"] = { fuse=1.6, floor=false, radius=0.4 },
    ["Decoy Grenade"] = { fuse=1.6, floor=false, radius=0.35 },
    ["Molotov"] = { fuse=nil, floor=true, radius=0.35 },
    ["Incendiary Grenade"] = { fuse=nil, floor=true, radius=0.35 },
}

local function nadeMatch(name)
    if not name then return nil end
    local lower = string.lower(name)
    for k, v in pairs(SPEC) do
        if string.find(lower, string.lower(k), 1, true) then return v, k end
    end
    if string.find(lower, "molot", 1, true) or string.find(lower, "incend", 1, true) then
        return { fuse=nil, floor=true, radius=0.35 }, name
    end
    if string.find(lower, "flash", 1, true) then
        return { fuse=1.7, floor=false, radius=0.35 }, name
    end
    return { fuse=1.6, floor=false, radius=0.35 }, name
end

local function nadeFuse(name)
    local spec = nadeMatch(name)
    if not spec then return nil, false end
    local override = tonumber(O.NadeFuseOverride) or 0
    local fuse = spec.fuse
    if override > 0 and not spec.floor then fuse = override end
    return fuse, spec.floor, spec.radius
end

-- ============================================================
-- detect held nade
-- ============================================================

local function equippedNadeName()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    for _, ch in ipairs(cam:GetChildren()) do
        if ch:IsA("Model") and ch.Name ~= "" and ch.Name ~= "Model" then
            local lower = string.lower(ch.Name)
            if lower:find("nade") or lower:find("grenade") or lower:find("flash")
                or lower:find("smoke") or lower:find("molot")
                or lower:find("incend") or lower:find("decoy") or lower:find("frag") then
                return ch.Name
            end
        end
    end
    return nil
end

-- ============================================================
-- physics fallback
-- ============================================================

local function simulate(origin, velocity, name, points, ignore)
    points = points or {}
    for i = #points, 1, -1 do points[i] = nil end

    local dt = 1/60
    local gravity = Vector3.new(0, -Workspace.Gravity, 0)
    local elasticity = 0.42
    local sleepVel = 6
    local fuse, onFloor = nadeFuse(name)
    local pos, vel = origin, velocity
    local bounces = 0
    local stopIndex, stopTime, stopWhy
    local elapsed = 0
    points[1] = pos

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignore or {}

    for _ = 1, 420 do
        local nextVel = vel + gravity*dt
        local nextPos = pos + nextVel*dt

        if fuse and elapsed >= fuse then
            stopIndex = #points
            stopTime = elapsed
            stopWhy = "FUSE"
            break
        end

        local hit = Workspace:Raycast(pos, nextPos - pos, rayParams)
        elapsed = elapsed + dt

        if hit then
            pos = hit.Position + hit.Normal*0.05
            points[#points+1] = pos
            local normal = hit.Normal
            if onFloor and normal.Y > 0.7 then
                stopIndex = #points
                stopTime = elapsed
                stopWhy = "FLOOR"
                break
            end
            vel = (nextVel - 2*nextVel:Dot(normal)*normal)*elasticity
            bounces = bounces + 1
            if bounces > 4 then
                stopWhy = "BOUNCES"
                break
            end
            if vel.Magnitude < sleepVel and not fuse then
                stopWhy = "REST"
                break
            end
        else
            pos, vel = nextPos, nextVel
            points[#points+1] = pos
        end
    end

    if not stopIndex then
        stopIndex = #points
        stopTime = elapsed
        stopWhy = stopWhy or "REST"
    end

    return points, stopIndex, stopTime, stopWhy
end

