-- ============================================================
-- Library compatibility layer
-- ============================================================
-- Попытается загрузить ui.lua от xDTaraZ, если нет — рисует fallback.

MV.Library = nil
MV.LibraryReady = false

function MV.LoadLibrary(url, timeout)
    timeout = timeout or 15
    local ok, source = pcall(game.HttpGet, game, url)
    if not ok or type(source) ~= "string" then
        MV.Log("library download failed: " .. tostring(source))
        return nil
    end
    local chunk, err = loadstring(source)
    if type(chunk) ~= "function" then
        MV.Log("library loadstring: " .. tostring(err))
        return nil
    end
    local ran, lib = pcall(chunk)
    if not ran or type(lib) ~= "table" then
        MV.Log("library execute: " .. tostring(lib))
        return nil
    end
    return lib
end

function MV.Boot()
    local lib = MV.LoadLibrary(MV.Config.UiSource
        or "https://raw.githubusercontent.com/xDTaraZz/Roblox-Scripts/refs/heads/main/ui.lua")
    if not lib then
        MV.Log("fallback UI (no library)")
        MV.BuildFallbackUI()
        MV.LibraryReady = false
        return
    end
    MV.Library = lib
    MV.LibraryReady = true

    local ok, err = pcall(function()
        lib:CreateWindow({
            Title = "Mario Visuals",
            SubTitle = "BloxStrike visual suite",
            MenuKey = Enum.KeyCode.RightControl,
            ConfigFolder = "MarioVisuals",
            Language = "Auto",
            Theme = "Overworld",
            Intro = false,
        })
    end)
    if not ok then
        MV.Log("CreateWindow: " .. tostring(err))
        MV.LibraryReady = false
        MV.BuildFallbackUI()
        return
    end
    MV.BuildAllTabs()
end

-- ============================================================
-- fallback UI (если Library недоступна)
-- ============================================================

function MV.BuildFallbackUI()
    local host = nil
    pcall(function() host = gethui() end)
    if not host then host = game:GetService("CoreGui") end

    local screen = MV.Mk("ScreenGui", host, {
        Name = "MarioVisualsFallback",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 1000,
    })
    local win = MV.Mk("Frame", screen, {
        Name = "MarioWindow",
        Size = UDim2.fromOffset(880,540),
        Position = UDim2.new(0.5,0,0.5,0),
        AnchorPoint = Vector2.new(0.5,0.5),
        BackgroundColor3 = Color3.fromRGB(18,18,22),
        BorderSizePixel = 0,
    })
    MV.Mk("UICorner", win, { CornerRadius = UDim.new(0,10) })
    MV.Mk("UIStroke", win, { Color = Color3.fromRGB(46,46,56), Thickness = 1 })

    MV.Mk("TextLabel", win, {
        Size = UDim2.new(1,0,0,42),
        BackgroundColor3 = Color3.fromRGB(14,14,18),
        BorderSizePixel = 0,
        Text = "Mario Visuals · fallback UI",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(230,230,238),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Position = UDim2.fromOffset(16,0)

    local body = MV.Mk("TextLabel", win, {
        Size = UDim2.new(1,-24,1,-60),
        Position = UDim2.fromOffset(12,48),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(140,140,150),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Text = "Library ui.lua недоступна. Скачай ui.lua от xDTaraZ, или включи логи — какая именно ошибка была.\n\nВсе визуальные функции работают независимо от UI, если запустить код частей 2-5 и выставить опции вручную через _G.MarioVisuals.Options.",
    })

    MV.FallbackUI = screen
    MV.Log("fallback UI ready")
end

MV.Config.UiSource = MV.Config.UiSource
    or "https://raw.githubusercontent.com/xDTaraZz/Roblox-Scripts/refs/heads/main/ui.lua"

MV.Log("part 1 loaded (bootstrap + library compat)")
