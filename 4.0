-- namespace
-- ============================================================

local MV = _G.MarioVisuals or {}
_G.MarioVisuals = MV
MV.Config = MV.Config or {}
MV.State = MV.State or {
    Connections = {},
    Visuals = {},
    Drawings = {},
    Pools = { Lines = {}, Boxes = {}, Text = {} },
    Halted = {},
    Notices = {},
    Traces = {},
}

-- ============================================================
-- shared palette + helpers (совпадает с xDTaraZ Library)
-- ============================================================

MV.Palette = {
    red=Color3.fromRGB(230,60,60), orange=Color3.fromRGB(240,140,60),
    yellow=Color3.fromRGB(255,215,80), pink=Color3.fromRGB(255,120,200),
    magenta=Color3.fromRGB(255,60,220), cyan=Color3.fromRGB(80,220,240),
    green=Color3.fromRGB(90,220,120), blue=Color3.fromRGB(90,150,240),
    white=Color3.fromRGB(255,255,255), gray=Color3.fromRGB(160,160,170),
    lime=Color3.fromRGB(180,255,80), purple=Color3.fromRGB(180,90,240),
    teal=Color3.fromRGB(55,220,190), gold=Color3.fromRGB(255,190,55),
    ice=Color3.fromRGB(165,225,255), black=Color3.fromRGB(10,10,12),
}
MV.PaletteOrder = {
    "green","lime","cyan","teal","blue","purple","magenta","pink",
    "red","orange","yellow","gold","ice","white","gray","black",
}
function MV.col(name)
    return MV.Palette[name] or MV.Palette.white
end

function MV.Mk(class, parent, props)
    local item = Instance.new(class)
    for k,v in pairs(props or {}) do item[k] = v end
    if parent then item.Parent = parent end
    return item
end

function MV.Connect(signal, handler)
    local conn = signal:Connect(handler)
    table.insert(MV.State.Connections, conn)
    return conn
end

function MV.Try(label, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then warn("[Mario Visuals] " .. label .. ":", err) end
    return ok
end

function MV.Log(msg)
    warn("[Mario Visuals] " .. tostring(msg))
end

